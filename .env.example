# QIRA settings. Copy to .env (git-ignored) and edit; direnv loads it when you cd here.
# Without direnv: uv run --env-file .env qira ...

# Where the middleware reads traces. The QEMU and PIN tracers always write to
# /tmp/qira_logs/ and /tmp/qira_asm, so only change these to read traces kept
# elsewhere (e.g. a copy of samples/legacy).
QIRA_TRACE_DIR=/tmp/qira_logs/
QIRA_ASM_FILE=/tmp/qira_asm
QIRA_STATIC_CACHE_DIR=/tmp/qira_static_cache/

# Only needed for `uv tool install` (a checkout finds these by itself).
#QIRA_TRACER_DIR=/path/to/qira/tracers
#QIRA_LIBS_DIR=/path/to/qira/libs
